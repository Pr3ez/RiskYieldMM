# =============================================================================
# TARGET DESCRIPTIONS
# =============================================================================
# Each target predicts something different:
#
# DIRECTION (3-class: DOWN/UP/NEUTRAL)
#   - Predicts: Short-term price movement direction
#   - Method: Triple-barrier labeling with adaptive volatility threshold
#   - DOWN = clear short signal (hit stop-loss barrier)
#   - UP = clear long signal (hit take-profit barrier)
#   - NEUTRAL = no clear signal (didn't hit barrier strongly enough)
#   - Use case: Entry signal for directional trades
#
# TREND_REGIME (binary: DOWN/UP)
#   - Predicts: Medium-term trend state (trend-following indicator)
#   - Method: SMA crossover (SMA21 > SMA63 = uptrend)
#   - DOWN = SMA21 < SMA63 (downtrend / bearish regime)
#   - UP = SMA21 > SMA63 (uptrend / bullish regime)
#   - Use case: Filter trades to go WITH the trend, not against it
#
# VOL_REGIME (3-class: LOW/MED/HIGH)
#   - Predicts: Current volatility regime
#   - Method: Percentile-based classification of rolling volatility
#   - LOW = quiet market (favorable for mean-reversion)
#   - MED = normal volatility
#   - HIGH = volatile market (favorable for trend-following, needs wider stops)
#   - Use case: Position sizing, stop-loss adjustment, strategy selection
#
# VOLATILITY (regression)
#   - Predicts: Expected absolute return magnitude
#   - Method: Regression on |forward_return|
#   - Use case: Setting stop-loss/take-profit levels, position sizing
#
# NOTE: 'returns' target removed - redundant with direction + volatility
#   (returns ≈ sign(direction) × volatility)
#
# KEY DIFFERENCE: direction vs trend_regime
#   - direction: SHORT-TERM signal (1-12 bars) - "should I enter NOW?"
#   - trend_regime: MEDIUM-TERM context (21/63 SMA) - "is the market bullish/bearish?"
#   - Best practice: Only take direction=UP when trend_regime=UP (go with trend)
# =============================================================================

# Human-readable label names for each target type
LABEL_NAMES = {
    "direction": {0: "DOWN", 1: "UP", 2: "NEUTRAL"},
    "vol_regime": {0: "LOW", 1: "MED", 2: "HIGH"},
    "trend_regime": {0: "DOWN", 1: "UP"},
}


def get_label_name(config_name: str, label_value: int) -> str:
    """Get human-readable label name for a config's prediction."""
    target_type = get_target_type_from_config(config_name)
    if target_type in LABEL_NAMES:
        return LABEL_NAMES[target_type].get(int(label_value), str(label_value))
    return str(label_value)


