{
  "version": 1,
  "description": "Feature policy for standalone 8h bull/bear/chop regime prediction.",
  "source": "data/analysis_8h.parquet",
  "candidate_feature_policy": {
    "include": "all_non_target_columns",
    "exclude_prefixes": [
      "y_",
      "RAW_",
      "rolling_"
    ],
    "exclude_exact": [
      "timestamp"
    ]
  },
  "fold_safety_guard": {
    "drop_if_all_null": true,
    "drop_if_constant": true,
    "drop_if_missing_from_input": true,
    "drop_reason_labels": [
      "all_null",
      "constant",
      "missing",
      "leaky"
    ]
  },
  "methods": [
    "rule_threshold_v1",
    "gmm3_state_mapper",
    "hmm3_state_mapper",
    "supervised_3class_v1",
    "two_head_bull_bear_v1"
  ]
}
